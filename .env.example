# Copy to .env and fill in. .env is gitignored.
# Used by both docker-compose.yml and the Spring Boot backend.

# --- PostgreSQL + PostGIS (docker-compose) ---
POSTGRES_DB=wayfinder
POSTGRES_USER=wayfinder
POSTGRES_PASSWORD=wayfinder
POSTGRES_PORT=5433

# --- Redis (docker-compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---
# At least 32 characters. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=
# Short access token; the app renews it with the refresh token. The session ends after 7 days without use
JWT_EXPIRATION_MINUTES=15

# Optional: an ADMIN user is created on startup if both are set (needed to add/edit places)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend origins allowed by CORS (comma separated)
# https://localhost and capacitor://localhost are the Android/iOS app's WebView origins
# http://localhost = the emulator dev build (node scripts/android.mjs dev); not needed in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,http://localhost

# --- Weather (Open-Meteo, no API key needed) ---
WEATHER_BASE_URL=https://api.open-meteo.com

# --- Python AI service (FastAPI, ai-service/). Empty AI_SERVICE_URL = the backend uses its rule-based intent
# parser only and user photos stay unchecked (PENDING). ---
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
# Messages per user per day that go to OpenAI (bot/abuse protection). Beyond it the
# built-in rule-based parser answers, so users are never blocked.
AI_DAILY_LIMIT_PER_USER=150
# OpenAI spending shown in the admin area: the model's list prices in USD per 1M tokens
# (platform.openai.com/docs/pricing; defaults are gpt-4.1-mini's)
AI_PRICE_INPUT_PER_MILLION=0.40
AI_PRICE_OUTPUT_PER_MILLION=1.60
# Our own monthly lock: at this estimated cost the assistant uses the rule-based parser and photos wait until
# next month. Also set a budget limit in the OpenAI project itself (the hard backstop). 0 = no lock
AI_MONTHLY_BUDGET_USD=10

# --- Billing (Nomi Premium passes, sold through Google Play Billing) ---
# true = free test purchases via /api/v1/billing/dev/purchase. NEVER true in production.
BILLING_DEV_MODE=false
# Must equal appId in frontend/capacitor.config.ts
GOOGLE_PLAY_PACKAGE_NAME=com.nomi.app
# JSON key of a Google Cloud service account that has access to the app in Play Console
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# TL prices; must match the in-app product prices in Play Console
PRICE_DAILY_TRY=25
PRICE_WEEKLY_TRY=79
PRICE_MONTHLY_TRY=199
PRICE_YEARLY_TRY=1499
# Comma separated e-mails that never pay (e.g. your own account)
FREE_ACCESS_EMAILS=

# --- User photos ("Kullanıcılarımızdan fotoğraflar") ---
# Where verified photos are stored (relative to where the backend runs) and their URL prefix in API answers.
# The mobile app needs an absolute prefix, e.g. https://api.example.com/media/photos
PHOTOS_STORAGE_DIR=./data/photos
PHOTOS_PUBLIC_BASE=/media/photos
PHOTOS_DAILY_UPLOADS_PER_USER=10
# AI service: model for the photo check (must read images). Empty = OPENAI_MODEL
PHOTO_VERIFY_MODEL=

# --- OpenAI, read by the AI service ---
OPENAI_API_KEY=
# Any model with structured outputs that can also read images (photo check); default gpt-4.1-mini
OPENAI_MODEL=

# --- E-mail (SMTP) for "forgot password" codes ---
# e.g. Brevo, Resend, Amazon SES, or a Gmail app password. Empty MAIL_HOST = no e-mails are sent.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Nomi <no-reply@example.com>
# Local development only: print reset codes to the backend log when MAIL_HOST is empty
MAIL_DEV_LOG_CODES=false

# Google Places API (New) key: the place page checks whether a place is still there (closed for good -> hidden).
# Empty = no check. Never commit the real key.
GOOGLE_PLACES_API_KEY=

# Owner accounts with the admin area (comma separated). Keep the real ones only in .env
OWNER_EMAILS=
