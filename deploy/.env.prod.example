# Production settings. Copy to deploy/.env on the server (never commit it).

# Domain of the API, e.g. api.nomiapp.com (DNS A record -> this server)
DOMAIN=

# --- Database (internal; only the backend can reach it) ---
POSTGRES_DB=wayfinder
POSTGRES_USER=wayfinder
# Long random value: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Security ---
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The Android app's WebView origin
CORS_ALLOWED_ORIGINS=https://localhost

WEATHER_BASE_URL=https://api.open-meteo.com

# --- AI service ---
# openssl rand -hex 32 (shared by backend and AI service)
AI_SERVICE_API_KEY=
OPENAI_API_KEY=
AI_DAILY_LIMIT_PER_USER=150
# Model for the user photo check (must read images). Empty = OPENAI_MODEL (default gpt-4.1-mini)
PHOTO_VERIFY_MODEL=

# --- User photos (storage dir and URL are set in docker-compose.prod.yml) ---
PHOTOS_DAILY_UPLOADS_PER_USER=10

# --- Billing ---
BILLING_DEV_MODE=false
GOOGLE_PLAY_PACKAGE_NAME=com.nomi.app
# Put the service account JSON at deploy/secrets/play-service-account.json
PRICE_DAILY_TRY=25
PRICE_WEEKLY_TRY=79
PRICE_MONTHLY_TRY=199
PRICE_YEARLY_TRY=1499
# Accounts that never pay (e.g. your own)
FREE_ACCESS_EMAILS=


# --- Website build ---
# Map tiles for a public site need your own provider key (e.g. MapTiler)
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_SUPPORT_EMAIL=
# Google Play listing once the app is published; the website links to it (Premium is not sold on the web)
VITE_PLAY_STORE_URL=

# --- E-mail (password reset codes) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Nomi <no-reply@example.com>
MAIL_DEV_LOG_CODES=false
