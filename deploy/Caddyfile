# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically (Let's Encrypt).
# The DNS A record of the domain must point to this server first.
{$DOMAIN} {
	encode gzip

	# API (and health only from actuator)
	@api path /api/* /actuator/health
	handle @api {
		# Photo uploads are at most 12 MB (the backend checks it too); nothing else is this big
		request_body {
			max_size 13MB
		}
		reverse_proxy backend:8080
	}

	# Verified user photos, straight from the backend's photos volume. File names are random and never
	# change, so they are cached for a year. No directory listings.
	handle_path /media/photos/* {
		root * /srv/photos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Legal pages: https://DOMAIN/gizlilik, /kosullar, ...
	@legal path /gizlilik /kosullar /iletisim /legal.css
	handle @legal {
		root * /srv/site
		try_files {path}.html {path}
		file_server
	}

	# Website: prerendered pages (/, /places/1, /kadikoy/kafe), else the plain app shell
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html /app.html
		file_server
	}

	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
}
