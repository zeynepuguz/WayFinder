# Copy to .env.production before building the store version (node scripts/android.mjs release)

# Public HTTPS address of the Spring Boot backend
VITE_API_BASE_URL=https://api.example.com/api/v1

# Maps: OpenFreeMap vector styles by default (free, commercial use allowed, no key). Only to use another MapLibre
# style (e.g. our own tile server later):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# Shown on the about / privacy / terms pages (in the app: /iletisim, /gizlilik, /kosullar) and under Profile
VITE_SUPPORT_EMAIL=destek@example.com
# Google Play listing of the app; the website paywall links here (Premium is not sold on the web)
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.nomi.app

# Error reports (sentry.io, a "React" project). Empty = off; the Sentry code is then not even downloaded
VITE_SENTRY_DSN=
