# Copy to .env.production before building the store version (node scripts/android.mjs release)

# Public HTTPS address of the Spring Boot backend
VITE_API_BASE_URL=https://api.example.com/api/v1

# Map tiles for a commercial app need your own provider + key (e.g. MapTiler, Stadia Maps)
VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Required by Google Play: public privacy policy (and terms) pages
VITE_PRIVACY_URL=https://example.com/privacy
VITE_TERMS_URL=https://example.com/terms
VITE_SUPPORT_EMAIL=destek@example.com
